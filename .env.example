# ─── Supabase (auto-injected into Edge Functions — do not set manually) ────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Anthropic / Claude ────────────────────────────────────────────────────────
# Required for enrich-ai function
ANTHROPIC_API_KEY=sk-ant-...

# ─── NYC Open Data ────────────────────────────────────────────────────────────
# Optional but strongly recommended — raises rate limits significantly
# Register at: https://data.cityofnewyork.us/profile/app_tokens
NYC_OPEN_DATA_APP_TOKEN=

# ─── Make.com Security ────────────────────────────────────────────────────────
# Set this in both Make.com HTTP headers and Supabase Edge Function secrets.
# Any random 32+ char string works: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=

# Make.com outbound webhook that receives notification payloads (email/SMS routing)
# Create a "Custom Webhook" scenario in Make.com and paste its URL here.
MAKE_NOTIFY_WEBHOOK=https://hook.us2.make.com/...

# ─── BT Capital Investor Complaint Platform ────────────────────────────────────
# See docs/complaints-platform.md — independent module, reuses MAKE_WEBHOOK_SECRET above.

# Make.com webhook — immediate + day 15/25/30 FINRA 30-day clock alerts to the compliance officer
COMPLIANCE_ALERT_WEBHOOK=https://hook.us2.make.com/...

# Make.com webhook — notifies the qualified third-party escrow agent on fund-disbursement complaints
ESCROW_AGENT_ALERT_WEBHOOK=https://hook.us2.make.com/...

# Make.com webhook — auto-reply confirmation email to the complainant
COMPLAINANT_CONFIRMATION_WEBHOOK=https://hook.us2.make.com/...
