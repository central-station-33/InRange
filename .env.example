# ─── Supabase (auto-injected into Edge Functions — do not set manually) ────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Server-only. NEVER expose this to browser/client-side code — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# Safe for browser/client-side code (RLS still applies). Only needed once a
# client-side CRM UI exists — not used by any Edge Function in this repo today.
SUPABASE_ANON_KEY=<your-anon-key>

# ─── Anthropic / Claude ────────────────────────────────────────────────────────
# Required for enrich-ai function today; also the Phase 2 second-pass reviewer
# in the AI lead enrichment blueprint (docs/ai-lead-enrichment-blueprint.md).
ANTHROPIC_API_KEY=sk-ant-...

# ─── Google / Gemini ───────────────────────────────────────────────────────────
# RESERVED — not yet used by any function in this repo.
# Required starting Phase 1 of docs/ai-lead-enrichment-blueprint.md
# (lead-classify: primary extraction/classification). Do not set until that
# phase is approved and the function exists.
GEMINI_API_KEY=

# ─── SkipData ───────────────────────────────────────────────────────────────────
# RESERVED — not yet used by any function in this repo.
# Required starting Phase 3 of docs/ai-lead-enrichment-blueprint.md
# (skip-trace-dispatch). SkipData's own integration details (auth scheme,
# base URL) aren't documented in this repo yet — see blueprint §8.
SKIPDATA_API_KEY=

# ─── AI Lead Enrichment webhook auth ────────────────────────────────────────────
# RESERVED — not yet used. Distinct secret from MAKE_WEBHOOK_SECRET below:
# this one is scoped to guard the future lead-classify/lead-review/
# skip-trace-dispatch endpoints specifically, so it can be rotated
# independently of the existing ingest/score/notify pipeline's secret.
ENRICHMENT_WEBHOOK_SECRET=

# ─── Admin allowlist ─────────────────────────────────────────────────────────────
# RESERVED — not yet used by any function in this repo. Intended purpose
# (e.g. gating compliance_playbook edits or admin-only views) is not yet
# decided — see "Open decisions" in docs/ai-lead-enrichment-blueprint.md.
# Comma-separated list of emails, e.g. alice@jrealty.com,bob@jrealty.com
INTERNAL_ADMIN_EMAILS=

# ─── NYC Open Data ────────────────────────────────────────────────────────────
# Optional but strongly recommended — raises rate limits significantly
# Register at: https://data.cityofnewyork.us/profile/app_tokens
NYC_OPEN_DATA_APP_TOKEN=

# ─── Make.com Security ────────────────────────────────────────────────────────
# Set this in both Make.com HTTP headers and Supabase Edge Function secrets.
# Any random 32+ char string works: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=

# Make.com outbound webhook that receives notification payloads (email/SMS routing)
# Create a "Custom Webhook" scenario in Make.com and paste its URL here.
MAKE_NOTIFY_WEBHOOK=https://hook.us2.make.com/...
