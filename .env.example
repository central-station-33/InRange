# ─── Supabase (auto-injected into Edge Functions — do not set manually) ────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Anthropic / Claude ────────────────────────────────────────────────────────
# Required for enrich-ai function
ANTHROPIC_API_KEY=sk-ant-...

# ─── NYC Open Data ────────────────────────────────────────────────────────────
# Optional but strongly recommended — raises rate limits significantly
# Register at: https://data.cityofnewyork.us/profile/app_tokens
NYC_OPEN_DATA_APP_TOKEN=

# ─── Make.com Security ────────────────────────────────────────────────────────
# Set this in both Make.com HTTP headers and Supabase Edge Function secrets.
# Any random 32+ char string works: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=

# Make.com outbound webhook that receives notification payloads (email/SMS routing)
# Create a "Custom Webhook" scenario in Make.com and paste its URL here.
MAKE_NOTIFY_WEBHOOK=https://hook.us2.make.com/...

# ─── Finance Agents ─────────────────────────────────────────────────────────
# See docs/finance-agents.md. Uses the same SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# and (optionally) the same ANTHROPIC_API_KEY as above — only these are new:

# Shared secret required on the `x-finance-secret` header for all finance-*
# edge functions. Any random 32+ char string works: openssl rand -hex 32
FINANCE_WEBHOOK_SECRET=

# Optional — overrides the Claude model used to write recommendation rationale text.
# If ANTHROPIC_API_KEY is unset, agents fall back to a deterministic template.
ANTHROPIC_MODEL=claude-sonnet-4-6
