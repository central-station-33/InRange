# ─── Supabase (auto-injected into Edge Functions — do not set manually) ────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Google / Gemini ───────────────────────────────────────────────────────────
# Required for enrich-ai function — Gemini is the primary enrichment model,
# called on every Tier 1-2 property. See docs/model-routing.md.
GEMINI_API_KEY=

# ─── Anthropic / Claude ────────────────────────────────────────────────────────
# Required for enrich-ai function — Claude is a selective escalation model,
# only invoked when Gemini's output meets an escalation condition
# (see CLAUDE_ESCALATION_DEAL_VALUE_THRESHOLD below and docs/model-routing.md).
ANTHROPIC_API_KEY=sk-ant-...

# Deal-value threshold (USD) above which a record is escalated to Claude.
# Optional — defaults to 400000 if unset.
CLAUDE_ESCALATION_DEAL_VALUE_THRESHOLD=400000

# ─── Canonical data model ────────────────────────────────────────────────────
# Used by ingest-nyc, ingest-nj, and process-raw-records when writing to
# raw_records/properties/parties/leads. This app has no multi-tenancy
# concept elsewhere, so a seeded "Default Organization" row is used if
# unset — see supabase/migrations/20240105000000_canonical_pipeline_support.sql
# and docs/canonical-data-model.md.
DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# ─── NYC Open Data ────────────────────────────────────────────────────────────
# Optional but strongly recommended — raises rate limits significantly
# Register at: https://data.cityofnewyork.us/profile/app_tokens
NYC_OPEN_DATA_APP_TOKEN=

# ─── Make.com Security ────────────────────────────────────────────────────────
# Set this in both Make.com HTTP headers and Supabase Edge Function secrets.
# Any random 32+ char string works: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=

# Make.com outbound webhook that receives notification payloads (email/SMS routing).
# Only ever called by approve-notification, and only after a human agent has
# approved the notification — notify-subscribers itself never sends anything.
# Create a "Custom Webhook" scenario in Make.com and paste its URL here.
MAKE_NOTIFY_WEBHOOK=https://hook.us2.make.com/...
