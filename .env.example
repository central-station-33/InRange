# Rewritten 2026-09-17 against what supabase/functions/*/source actually
# reads via Deno.env.get(...) in the live project — not from memory. If you
# add a new Deno.env.get() call, add the var here in the same commit.

# ─── Supabase (auto-injected into Edge Functions — do not set manually) ────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Make.com Security ────────────────────────────────────────────────────────
# Checked by most functions against an x-make-secret (or similar) header.
# Any random 32+ char string works: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=

# Make.com webhook that ISA notifications route into (replaces the old
# MAKE_NOTIFY_WEBHOOK, which nothing reads anymore).
MAKE_ISA_WEBHOOK=https://hook.us2.make.com/...

# ─── Anthropic / Claude ────────────────────────────────────────────────────────
# Used by: enrich-leads, enrich-pending, respond-lead, follow-up-cadence, health
ANTHROPIC_API_KEY=sk-ant-...

# ─── Twilio ─────────────────────────────────────────────────────────────────────
# Used by: respond-lead, follow-up-cadence (inbound SMS response + nurture cadence)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── DataSkip (skip tracing) ────────────────────────────────────────────────────
# Used by: skip-trace-leads. Calls are gated by the skip_trace_confirmations
# table (service-role only) to prevent accidental repeat paid lookups.
DATASKIP_API_KEY=

# ─── SimplyRETS (ARV / sold comps) ──────────────────────────────────────────────
# Used by: estimate-arv-comps
SIMPLYRETS_API_KEY=
SIMPLYRETS_API_SECRET=

# ─── Slack ──────────────────────────────────────────────────────────────────────
# Used by: health-check
SLACK_WEBHOOK_URL=

# ─── NYC Open Data ────────────────────────────────────────────────────────────
# NOT currently read by any function (ingest-nyc/ingest-acris-investors call
# Socrata unauthenticated). Set this and wire it in if ingestion starts
# hitting 429s from the default rate limit.
# Register at: https://data.cityofnewyork.us/profile/app_tokens
# NYC_OPEN_DATA_APP_TOKEN=
